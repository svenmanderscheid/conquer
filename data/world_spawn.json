{
  "version": "1.0",
  "description": "Ascendancy world spawn configuration. Defines hourly spawn rates and per-sector caps for all map entities (resource mines, GEM nodes, monsters). Cron `world_spawn_tick.php` runs at xx:00 UTC every hour, iterates all 8 sectors per world, and spawns entities per the rates below. Total field objects + monsters per active world: ~50,000-100,000 in steady state.",
  "spawn_rules": {
    "schedule": "0 * * * *",
    "schedule_description": "Hourly cron tick at xx:00 UTC server-wide",
    "placement_constraints": {
      "min_distance_from_player_city_tiles": 5,
      "min_distance_from_shrine_tiles": 30,
      "blocked_terrain": [
        "water",
        "mountains"
      ],
      "high_level_entity_center_bias": true,
      "high_level_threshold": "lv >= 7 for monsters; tier == 'endgame' for resources"
    },
    "despawn_check_schedule": "*/5 * * * *",
    "despawn_check_description": "Every 5 minutes — remove entities past their despawn timer",
    "fractional_rate_handling": "If rate >= 1: spawn_count = floor(rate) + (1 if random() < (rate - floor(rate)) else 0). If rate < 1: spawn_count = 1 if random() < rate else 0. Then min(spawn_count, sector_cap - current_count)."
  },
  "sector_caps": {
    "_description": "Maximum concurrent entities per sector. Spawn tick skips entity type if cap reached.",
    "resource_mines_combined": 800,
    "gem_nodes_combined": 10,
    "solo_monsters_combined": 500,
    "treasure_goblins_combined": 80,
    "deathkar_combined": 30,
    "dragons_combined": 5,
    "magdar_combined": 1
  },
